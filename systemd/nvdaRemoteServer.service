# Sample systemd service file for the Go NVDARemoteServer.
# Modify the paths and the user/group to match your setup.
# The daemon commands are not needed here: systemd runs the server
# directly in the foreground (Type=simple) and manages it.
[Unit]
Description=NVDARemote server
After=network.target

[Service]
Type=simple
User=sample
Group=sample
ExecStart=/home/sample/bin/nvdaRemoteServer -configfile /etc/NVDARemoteServer.conf
StandardOutput=append:/home/sample/nvdaRemoteServer/stdout.log
StandardError=append:/home/sample/nvdaRemoteServer/stderr.log
Restart=always
RestartSec=10s
TimeoutStopSec=10s

[Install]
WantedBy=multi-user.target
